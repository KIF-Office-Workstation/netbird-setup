graph TD
    subgraph Reverse_Proxy["Traefik Reverse Proxy (Ports 80/tcp, 443/tcp)"]
        HTTP["HTTP (80) ACME Challenge"]
        HTTPS["HTTPS (443) TLS Termination"]
    end

    subgraph NetBird_Server_Stack["NetBird Self-Hosted Server Stack"]
        Dashboard["Dashboard UI Container (netbird-dashboard:80)"]
        ServerContainer["NetBird Combined Server (netbird-server)"]
        
        subgraph Embedded_Services["Embedded Services inside netbird-server"]
            Management["Embedded Management Service"]
            Signal["Embedded Signal Service"]
            Relay["Embedded Relay Engine (WebSockets/QUIC)"]
            STUN["Embedded STUN (3478/udp)"]
            Dex["Embedded Dex IdP (/oauth2)"]
        end
    end

    subgraph Mesh_Peers["NetBird WireGuard Overlay Peers (100.64.0.0/16)"]
        PeerA["Node A (100.64.0.1)"]
        PeerB["Node B (100.64.0.2)"]
    end

    HTTPS -->|/*| Dashboard
    HTTPS -->|/api, /oauth2, /relay, /ws-proxy| ServerContainer
    HTTPS -->|/signalexchange.*, /management.*| ServerContainer

    PeerA -->|gRPC Signal & Mgmt (443)| HTTPS
    PeerB -->|gRPC Signal & Mgmt (443)| HTTPS

    PeerA <-->|Direct P2P WireGuard (51820/udp)| PeerB
    PeerA -.->|Relay Fallback over WebSockets (443/tcp)| Relay
    PeerB -.->|Relay Fallback over WebSockets (443/tcp)| Relay
