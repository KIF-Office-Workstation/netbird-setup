# NetBird Modern Combined Server Configuration (config.yaml.example)
# Official combined netbird-server container architecture (v0.75.1)
# Official Reference: https://docs.netbird.io/selfhosting/getting-started

server:
  listenAddress: ":80"
  exposedAddress: "https://netbird.example.com:443"
  stunPorts:
    - 3478
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "YOUR_RELAY_AUTH_SECRET_PLACEHOLDER"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://netbird.example.com/oauth2"
    signKeyRefreshEnabled: true
    dashboardRedirectURIs:
      - "https://netbird.example.com/nb-auth"
      - "https://netbird.example.com/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"

  reverseProxy:
    trustedHTTPProxies:
      - "172.30.0.0/24"

  store:
    engine: "sqlite"
    encryptionKey: "YOUR_DATASTORE_ENCRYPTION_KEY_PLACEHOLDER"
