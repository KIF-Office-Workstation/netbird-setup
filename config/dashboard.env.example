# NetBird Dashboard Environment Variables (dashboard.env.example)
NETBIRD_MGMT_API_ENDPOINT=https://netbird.example.com
NETBIRD_MGMT_SINGLE_ACCOUNT_MODE=true
AUTH_AUDIENCE=netbird-api
AUTH_CLIENT_ID=YOUR_OIDC_CLIENT_ID_PLACEHOLDER
AUTH_AUTHORITY=https://netbird.example.com/auth
AUTH_SUPPORTED_SCOPES=openid profile email
USE_AUTH0=false
