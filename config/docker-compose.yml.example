# NetBird Modern Combined Server Architecture (docker-compose.yml.example)
# Production-ready stack: Traefik v3 Reverse Proxy, NetBird Server (Combined Management, Signal, STUN, Relay), Dashboard UI
# Official Documentation: https://docs.netbird.io/selfhosting/getting-started

version: '3.8'

services:
  # Traefik Reverse Proxy & Automated Let's Encrypt TLS
  traefik:
    image: traefik:v3.1
    container_name: netbird-traefik
    restart: unless-stopped
    command:
      - "--providers.docker=true"
      - "--providers.docker.exposedbydefault=false"
      - "--entrypoints.web.address=:80"
      - "--entrypoints.websecure.address=:443"
      - "--certificatesresolvers.le.acme.httpchallenge=true"
      - "--certificatesresolvers.le.acme.httpchallenge.entrypoint=web"
      - "--certificatesresolvers.le.acme.email=admin@example.com"
      - "--certificatesresolvers.le.acme.storage=/letsencrypt/acme.json"
    ports:
      - "80:80/tcp"       # HTTP ACME Challenge & Redirect
      - "443:443/tcp"     # HTTPS NetBird Dashboard, gRPC, & Relay
    volumes:
      - "/var/run/docker.sock:/var/run/docker.sock:ro"
      - "./letsencrypt:/letsencrypt"
    networks:
      - netbird-net

  # NetBird Dashboard (Admin Web UI)
  dashboard:
    image: netbirdio/dashboard:latest
    container_name: netbird-dashboard
    restart: unless-stopped
    env_file:
      - dashboard.env
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.dashboard.rule=Host(`${NETBIRD_DOMAIN}`)"
      - "traefik.http.routers.dashboard.entrypoints=websecure"
      - "traefik.http.routers.dashboard.tls.certresolver=le"
      - "traefik.http.services.dashboard.loadbalancer.server.port=80"
    networks:
      - netbird-net

  # NetBird Combined Server (Embedded Management, Signal, STUN, and Relay)
  # Replaces legacy separate management, signal, and coturn containers
  netbird-server:
    image: netbirdio/netbird-server:latest
    container_name: netbird-server
    restart: unless-stopped
    ports:
      - "3478:3478/udp"   # STUN/TURN Service for NAT Traversal
      - "51820:51820/udp" # (Optional) WireGuard P2P Proxy
    volumes:
      - netbird_data:/var/lib/netbird
      - "./config.yaml:/etc/netbird/config.yaml"
    command: ["--config", "/etc/netbird/config.yaml"]
    labels:
      - "traefik.enable=true"
      # Native gRPC (Signal & Management)
      - "traefik.http.routers.netbird-grpc.rule=Host(`${NETBIRD_DOMAIN}`) && (PathPrefix(`/signalexchange.SignalExchange/`) || PathPrefix(`/management.ManagementService/`))"
      - "traefik.http.routers.netbird-grpc.entrypoints=websecure"
      - "traefik.http.routers.netbird-grpc.tls.certresolver=le"
      - "traefik.http.routers.netbird-grpc.service=netbird-grpc-svc"
      - "traefik.http.services.netbird-grpc-svc.loadbalancer.server.port=80"
      - "traefik.http.services.netbird-grpc-svc.loadbalancer.server.scheme=h2c"
      # HTTP & Relay Endpoints (API, OAuth2, Relay WebSockets)
      - "traefik.http.routers.netbird-http.rule=Host(`${NETBIRD_DOMAIN}`) && (PathPrefix(`/api`) || PathPrefix(`/oauth2`) || PathPrefix(`/relay`) || PathPrefix(`/ws-proxy`))"
      - "traefik.http.routers.netbird-http.entrypoints=websecure"
      - "traefik.http.routers.netbird-http.tls.certresolver=le"
      - "traefik.http.services.netbird-http.loadbalancer.server.port=80"
    networks:
      - netbird-net

volumes:
  netbird_data:

networks:
  netbird-net:
    driver: bridge
