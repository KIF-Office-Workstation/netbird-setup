graph TD
    subgraph Control_Plane["NetBird Control Plane (Server Stack)"]
        Dashboard["Dashboard UI (Port 80/443)"]
        Management["Management Service (Port 33073 gRPC)"]
        Signal["Signal Service (Port 10000 gRPC)"]
        Coturn["Coturn STUN/TURN (Port 3478 UDP/TCP)"]
    end

    subgraph Overlay_Mesh["NetBird WireGuard Overlay Mesh (100.64.0.0/16)"]
        NodeA["Linux Server Node (100.64.0.1)"]
        NodeB["WSL / Client Node B (100.64.0.2)"]
        NodeC["Workstation Node C (100.64.0.3)"]
    end

    Dashboard -->|API Control| Management
    NodeA -->|Register / Sync| Management
    NodeB -->|Register / Sync| Management
    NodeC -->|Register / Sync| Management

    NodeA -->|Signal Exchange| Signal
    NodeB -->|Signal Exchange| Signal
    NodeC -->|Signal Exchange| Signal

    NodeA <-->|Direct WireGuard P2P (UDP 51820)| NodeB
    NodeB <-->|Direct WireGuard P2P (UDP 51820)| NodeC
    NodeA <-->|Direct WireGuard P2P (UDP 51820)| NodeC

    NodeA -.->|Fallback Relay (UDP 3478)| Coturn
    NodeB -.->|Fallback Relay (UDP 3478)| Coturn
